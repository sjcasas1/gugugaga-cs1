# Droidspaces kernel options for Meizu 20 Pro (m2391), kernel 5.15 / android13-5.15
# Kernel configuration for full DroidSpaces support (GKI-safe subset)
#
# LTO: full LTO 在 16GB runner 上会在 vmlinux.o 阶段被 OOM 杀掉（run #2 exit 143）
# 改成 Android GKI 默认的 ThinLTO，内存/时间都降一个量级，CFI 仍然保留。
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO_CLANG_THIN=y

# GKI-safe: enabling these keeps struct task_struct layout, exported symbol CRCs
# and the vendor-module ABI untouched once the sched.h kABI patch is applied.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y

# --- Optional: recommended, still kABI-safe on 5.15 (verified by upstream) ---
CONFIG_USER_NS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- Optional: FUSE / TUN inside containers (TUN is already enabled) ---
# CONFIG_FUSE_FS=y

# --- DO NOT ENABLE (they break the GKI kABI; no padding covers them) ---
# CONFIG_CFS_BANDWIDTH=y     # needed by --cpus
# CONFIG_CGROUP_PIDS=y       # needed by --pids-limit
# Only enable these two if you rebuild and flash EVERY kernel module from this
# same tree together with boot.img (vendor_boot / vendor_dlkm / system_dlkm).
