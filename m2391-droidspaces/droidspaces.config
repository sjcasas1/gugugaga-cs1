# Droidspaces kernel options — Meizu 20 Pro (m2391) / 5.15 GKI
# 最小化：只开 Droidspaces 真正检查并用到的选项，不加任何"顺便"功能。

# LTO: FullLTO 在 16GB runner 上于 vmlinux.o 阶段被 OOM 终止，改 ThinLTO（CFI 保留）
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO_CLANG_THIN=y

# --- 必需：没有这些容器起不来 ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y

# --- 网络隔离：NAT / macvlan 需要 ---
CONFIG_MACVLAN=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- 易失模式（overlayfs）---
CONFIG_OVERLAY_FS=y

# --- 容器内 FUSE / VPN ---
CONFIG_FUSE_FS=y

# --- 允许沙箱 / docker unsafe procfs 修复 ---
CONFIG_USER_NS=y

# --- 故意不开 ---
# CONFIG_CFS_BANDWIDTH=y   # --cpus 需要；改变调度器结构体，导出符号 CRC 大面积变化
# CONFIG_CGROUP_PIDS=y     # --pids-limit 需要；同上
# 开这两项必须用同一份源码重编全部模块并一起刷 vendor_dlkm / system_dlkm。
